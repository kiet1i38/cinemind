CINEMIND_ENVIRONMENT=development
DATABASE_URL=postgresql://replace-with-user:replace-with-password@localhost:5432/cinemind
CATALOG_SEED_PATH=../frontend/public/data/catalog.json
MIGRATIONS_PATH=./migrations
CATALOG_SOURCE_NAME=Netflix Movies and TV Shows
CATALOG_SOURCE_TYPE=kaggle
CATALOG_SOURCE_URI=https://www.kaggle.com/datasets/shivamb/netflix-shows/data
CATALOG_SCHEMA_VERSION=catalog-json-v1
DB_CONNECT_RETRIES=30
DB_CONNECT_RETRY_DELAY_SECONDS=1
DB_CONNECT_TIMEOUT_SECONDS=5
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_POOL_TIMEOUT_SECONDS=5
MAX_REQUEST_BODY_BYTES=32768
TRUST_PROXY_HEADERS=false
REQUIRE_HTTPS=false
AUTH_COOKIE_NAME=cinemind_auth
AUTH_SESSION_TTL_DAYS=30
AUTH_PASSWORD_ITERATIONS=600000
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
INTERACTION_RATE_LIMIT_WINDOW_SECONDS=60
INTERACTION_RATE_LIMIT_MAX_ATTEMPTS=120
ADMIN_RESET_USERNAME=replace-with-an-admin-username
ADMIN_RESET_PASSWORD=replace-with-a-long-random-password
# Destructive maintenance endpoints are opt-in for local test runs only.
RESET_ENABLED=true
FULL_RESET_ENABLED=false
